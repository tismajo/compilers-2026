{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Compiscript",
  "scopeName": "source.compiscript",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#classes" },
    { "include": "#calls" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.compiscript",
          "match": "//.*$"
        },
        {
          "name": "comment.block.compiscript",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.compiscript",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "invalid.illegal.newline.compiscript",
          "match": "\\n"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.compiscript",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.compiscript",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(function)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.compiscript" },
            "2": { "name": "entity.name.function.compiscript" }
          }
        },
        {
          "match": "\\b(class)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.class.compiscript" },
            "2": { "name": "entity.name.type.class.compiscript" }
          }
        },
        {
          "match": "\\b(let|var|const)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.compiscript" },
            "2": { "name": "variable.other.declaration.compiscript" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.compiscript",
          "match": "\\b(if|else|while|do|for|foreach|in|break|continue|return|try|catch|switch|case|default)\\b"
        },
        {
          "name": "keyword.other.compiscript",
          "match": "\\b(function|class|let|var|const|new|print)\\b"
        },
        {
          "name": "variable.language.this.compiscript",
          "match": "\\bthis\\b"
        }
      ]
    },
    "types": {
      "name": "support.type.primitive.compiscript",
      "match": "\\b(boolean|integer|float|string|void)\\b"
    },
    "constants": {
      "name": "constant.language.compiscript",
      "match": "\\b(true|false|null)\\b"
    },
    "classes": {
      "name": "entity.name.type.compiscript",
      "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
    },
    "calls": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.call.compiscript" }
      }
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.compiscript",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.comparison.compiscript",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.compiscript",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.assignment.compiscript",
          "match": "="
        },
        {
          "name": "keyword.operator.ternary.compiscript",
          "match": "\\?|:"
        }
      ]
    }
  }
}
